{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "electron:dev": "pnpm build && electron .",
    "dist:mac": "pnpm build && electron-builder --mac dmg --publish never",
    "dist:win": "pnpm build && electron-builder --win nsis --publish never",
    "dist": "pnpm build && electron-builder --mac dmg --win nsis --publish never"
  },
  "dependencies": {
    "mathjs": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  },
  "build": {
    "appId": "com.facundogrillo.numlab",
    "productName": "NumLab",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/icon.png",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.education",
      "icon": "src/icon.png"
    },
    "win": {
      "target": ["nsis"],
      "icon": "src/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
